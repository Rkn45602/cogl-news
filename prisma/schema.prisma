datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPERADMIN
  EDITOR
  REPORTER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProofType {
  PRIMARY_DOCUMENT
  VIDEO_EVIDENCE
  AUDIO_EVIDENCE
  PHOTO_EVIDENCE
  SOURCE_ATTRIBUTION
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(REPORTER)
  createdAt    DateTime  @default(now())
  articles     Article[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
}

model Article {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  summary        String
  contentHtml    String        @db.Text
  featuredImage  String
  videoEmbedUrl  String?
  readingTimeMin Int           @default(3)
  status         ArticleStatus @default(PUBLISHED)
  isBreaking     Boolean       @default(false)
  isLead         Boolean       @default(false)
  isFactChecked  Boolean       @default(true)
  publishedAt    DateTime      @default(now())

  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  authorId       String
  author         User          @relation(fields: [authorId], references: [id])
  proofs         ArticleProof[]
}

model ArticleProof {
  id          String    @id @default(cuid())
  articleId   String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  title       String
  type        ProofType @default(PRIMARY_DOCUMENT)
  sourceName  String
  fileUrl     String
  notes       String?
  createdAt   DateTime  @default(now())
}
